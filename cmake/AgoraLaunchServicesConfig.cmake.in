@PACKAGE_INIT@

# Consume Launch Services (libagora-launchservices), Agora's Launch Services.
#
# ITS ONE DEPENDENCY IS FOUND, BECAUSE IT IS IN THE INTERFACE: every door is spelled with Core Foundation
# types — `CFStringRef` for a type, `CFURLRef` for an application — so a consumer of Launch Services reaches
# Core Foundation itself. FOUNDATION IS NOT AMONG THEM AND MUST NOT BE: it sits above this library in the
# stack, and the AppKit's `NSWorkspace` is the layer that reaches down, not the layer this reaches up to.

include(CMakeFindDependencyMacro)

find_dependency(CoreFoundation CONFIG)

if(CMAKE_C_COMPILER_ID STREQUAL "GNU")
  message(FATAL_ERROR
    "libagora-launchservices' interface brings Core Foundation's headers, which need -fblocks. This tree "
    "builds with clang; configure with -DCMAKE_C_COMPILER=/usr/bin/clang-19.")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/AgoraLaunchServicesTargets.cmake")

check_required_components(AgoraLaunchServices)
